# Bluetooth LE via NimBLE (utils::bluetooth_announce on the idf framework).
# Ignored on esp32s2 (no Bluetooth controller).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
# NimBLE + std need a bigger main task stack than the 3.5 KiB default.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
